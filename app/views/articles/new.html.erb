<h1>新規投稿</h1>

<%= form_with(model: @article, local: true) do |form| %>
  <div class="form-group">
    <%= form.label :title, 'タイトル', class: "form-label" %>
    <%= form.text_field :title, class: "input-title" %>
  </div>

  <div class="form-group">
    <%= form.label :content, '投稿内容', class: "form-label" %>
    <%= form.text_area :content, rows: 3, class: "input-content" %>
  </div>

  <div class="form-actions">
    <%= form.submit '投稿', class: "btn-submit" %>
  </div>
<% end %>

<%= link_to '一覧に戻る', articles_path %>
