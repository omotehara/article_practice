<h1>投稿一覧</h1>

<%= link_to '新規投稿', new_article_path %>

<table>
  <thead>
    <tr>
      <th style="width: 30%;">タイトル</th>
      <th style="width: 70%;">投稿内容</th>
    </tr>
  </thead>
  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= link_to article.title, article_path(article) %></td>
        <td><%= article.content %></td>
      </tr>
    <% end %>
  </tbody>
</table>
