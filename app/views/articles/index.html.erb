
<h1>投稿一覧</h1>

<% if flash[:notice] %>
  <p class="flash-success">
    <%= flash[:notice] %>
  </p>
<% end %>

<% if flash[:alert] %>
  <p class="flash-error">
    <%= flash[:alert] %>
  </p>
<% end %>

<div class="article-list">
  <% @articles.each do |article| %>
    <div class="article-item">
      <h2>
        <%= link_to article.title, article_path(article) %>
      </h2>

      <p><%= article.content %></p>
    </div>
  <% end %>
</div>

<%= link_to "新規投稿", new_article_path, class: "button-primary" %>
