<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Article Practice" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Article Practice">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# 指示通り、application.css だけを読み込むように修正します %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# 投稿・編集完了時の緑メッセージ、削除時の赤メッセージを表示するエリア %>
    <% if flash[:notice] %>
      <div class="msg-notice"><%= flash[:notice] %></div>
    <% end %>

    <% if flash[:alert] %>
      <div class="msg-alert"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
  </body>
</html>
